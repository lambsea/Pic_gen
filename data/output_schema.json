{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoverDesignOutput",
  "type": "object",
  "required": [
    "cover_title",
    "article_summary",
    "visual_concept",
    "image_prompt",
    "negative_prompt",
    "detected_language",
    "color_scheme",
    "layout_spec",
    "brand_checklist",
    "topic_tags"
  ],
  "properties": {
    "cover_title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "description": "Compelling, concise cover title"
    },
    "subtitle": {
      "type": "string",
      "maxLength": 150,
      "description": "Optional subtitle or tagline"
    },
    "article_summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500,
      "description": "One-paragraph summary of article core argument"
    },
    "topic_tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 5,
      "description": "Relevant topic tags"
    },
    "visual_concept": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "description": "Plain-language description of the visual concept"
    },
    "image_prompt": {
      "type": "string",
      "minLength": 50,
      "maxLength": 1000,
      "description": "Detailed Recraft V4 image generation prompt — visual only, no text"
    },
    "negative_prompt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Elements to explicitly avoid in the generated image"
    },
    "detected_language": {
      "type": "string",
      "enum": ["zh", "en"],
      "description": "Detected article language: zh = Chinese, en = English"
    },
    "color_scheme": {
      "type": "string",
      "enum": ["dark", "light"],
      "description": "dark for English articles, light for Chinese articles"
    },
    "layout_spec": {
      "type": "object",
      "required": [
        "template_variant",
        "title_alignment",
        "safe_text_area",
        "logo_position",
        "overlay_opacity"
      ],
      "properties": {
        "template_variant": {
          "type": "string",
          "enum": ["A", "B", "C"],
          "description": "A=editorial, B=data/analysis, C=opinion"
        },
        "title_alignment": {
          "type": "string",
          "enum": ["center", "left"],
          "description": "Title text alignment on the cover"
        },
        "safe_text_area": {
          "type": "string",
          "description": "Description of which area is reserved for text overlay"
        },
        "logo_position": {
          "type": "string",
          "enum": ["bottom-right"],
          "description": "Fixed brand logo position"
        },
        "overlay_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity of dark/light overlay for text readability (0.3–0.7 recommended)"
        }
      },
      "additionalProperties": false
    },
    "brand_checklist": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Brand compliance check items confirmed for this design"
    }
  },
  "additionalProperties": false
}
