# API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
RECRAFT_API_KEY=your-recraft-api-key-here

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=INFO

# Article Extraction
SCRAPE_TIMEOUT_MS=8000
MAX_ARTICLE_LENGTH_CHARS=15000

# Claude
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2000
CLAUDE_MAX_RETRIES=2

# Recraft
RECRAFT_MODEL=recraftv4
RECRAFT_IMAGE_WIDTH=1200
RECRAFT_IMAGE_HEIGHT=675
RECRAFT_MAX_RETRIES=2
RECRAFT_RETRY_BASE_DELAY_MS=1000

# Output
OUTPUTS_DIR=./outputs
